{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "groupie",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "groupie-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "apps/server/src/index.ts"],
      "port": 3000
    },
    {
      "name": "groupie-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@groupie/web"],
      "port": 5173
    }
  ]
}
