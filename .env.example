# Telegram bot token from @BotFather (create bot, /setprivacy -> DISABLED before adding to any group)
BOT_TOKEN=

# Supabase Postgres connection string (Project Settings -> Database -> Connection string, "Transaction" pooler)
DATABASE_URL=

# Where the web app is served (used in /groupie reply links, cookies, CSRF)
WEB_APP_URL=http://localhost:3000

# Direct link of the BotFather-registered Mini App (t.me/<bot>/<shortname>).
# When set, /groupie replies with this so the board opens inside Telegram.
MINI_APP_URL=

# HTTP port for the API/web server
PORT=3000

# Signs session cookies — any long random string (e.g. openssl rand -hex 32)
SESSION_SECRET=

# Alchemy app key for Robinhood Chain (free tier). Its ABSENCE is the feature
# flag for the discovery build (docs/decisions.md rounds 18 and 20): with no key
# the chain listener never starts and /discovery answers enabled:false.
# Create at dashboard.alchemy.com -> new app -> network "Robinhood Mainnet".
ALCHEMY_API_KEY=

# Optional full RPC URL override (a self-hosted node, another provider, a test
# double). Wins over ALCHEMY_API_KEY when both are set.
ALCHEMY_RPC_URL=

# twitterapi.io key for the X launch monitor (docs/decisions.md round 23). Its
# ABSENCE is the feature flag: with no key the watcher never starts, /upcoming
# answers enabled:false and `/overseer track` says the monitor is off.
# NOTE: a Tier-A ping also needs ALCHEMY_API_KEY — the address a tracked account
# posts is confirmed on chain (code + symbol/decimals) before anything is said.
X_API_KEY=

# Optional base URL override for that provider (a test double, or a fallback
# vendor with the same shape). Defaults to https://api.twitterapi.io.
X_API_BASE=

# DEV ONLY: browse the board in a plain browser without Telegram auth.
# BOTH must be set, and it is force-disabled when NODE_ENV=production.
# Never set ENABLE_DEV_AUTH in a real deployment.
ENABLE_DEV_AUTH=
DEV_AUTH_USER_ID=
